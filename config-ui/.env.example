# Connection string for the configuration PostgreSQL database.
# Same DB the SearXNG plugin reads from.
DATABASE_URL="postgresql://auto_reranker:auto_reranker@localhost:5432/auto_reranker"

# Static bearer token gating all config-ui routes and APIs.
# REQUIRED: set a long random string. Do NOT commit a real value.
AUTORERANKER_TOKEN="change-me-to-a-long-random-secret"
